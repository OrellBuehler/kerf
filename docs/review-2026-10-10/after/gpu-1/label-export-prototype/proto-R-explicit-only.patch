+/// Whether a colour-matrix tag names a matrix: `unknown`, `unspecified` and `reserved` (which
+/// FFmpeg reads as the default, BT.601) do not, and neither does no tag at all.
+pub fn names_a_matrix(tag: Option<&str>) -> bool {
+    tag.is_some_and(|t| !matches!(t, "" | "unknown" | "unspecified" | "reserved"))
+}
+
+/// Whether a picture is **untagged HD YCbCr**: HD (mpv's rule, `width >= 1280 || height > 576`),
+/// YCbCr on the pixel-format allow-list but not `yuvj…` (JFIF and a webcam's MJPEG are BT.601 by
+/// definition), naming no matrix and not HDR (tone-mapped to a tagged BT.709 picture already).
+/// What every player shows as BT.709 and FFmpeg reads as BT.601.
+pub fn untagged_hd_yuv(color_space: Option<&str>, pix_fmt: &str, width: u32, height: u32, hdr: bool) -> bool {
+    if hdr || names_a_matrix(color_space) || pix_fmt.to_ascii_lowercase().starts_with("yuvj") {
+        return false;
+    }
+    matches!(pix_fmt_layout(pix_fmt), Some(PixLayout::Yuv420 | PixLayout::OtherYuv)) && (width >= 1280 || height > 576)
+}
