{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main Kerf window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-destroy",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/OrellBuehler/kerf/*" }]
    }
  ]
}
